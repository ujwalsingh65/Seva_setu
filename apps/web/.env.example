# Frontend Environment Variables (Vite)
# Only variables prefixed with VITE_ are accessible in the client browser.
# NEVER put private keys or secrets here.

VITE_API_BASE_URL=http://localhost:5000/api/v1
# In Vercel production, set this to the deployed Express API URL ending in /api/v1.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
VITE_MAPS_PUBLIC_KEY=
