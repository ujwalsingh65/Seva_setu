# ==============================================================================
# SevaSetu Root Environment Configuration Template
# Right Volunteer. Right Place. Right Impact.
#
# Refer to individual application environment templates for service-specific variables:
# - Frontend: apps/web/.env.example
# - Backend API: apps/api/.env.example
# - Agent Service: apps/agent/.env.example
# ==============================================================================

# Node Environment
NODE_ENV=development

# Web Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
VITE_MAPS_PUBLIC_KEY=

# Backend REST API (Node/Express)
PORT=5000
FRONTEND_URL=http://localhost:5173
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder

# Primary Database (Supabase PostgreSQL + PostGIS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=ey_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=ey_service_role_key_placeholder

# Ephemeral State & Real-time Layer (Firebase)
FIREBASE_PROJECT_ID=sevasetu-placeholder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sevasetu-placeholder.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# External Integrations
MAPS_API_KEY=maps_api_key_placeholder
EMAIL_API_KEY=email_api_key_placeholder
EMAIL_FROM=notifications@sevasetu.org
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sevasetu

# Event Intelligence Agent Service (Python FastAPI)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_SECRET=sevasetu_agent_internal_secret_placeholder
# Optional Event Intelligence provider. When unset, the deterministic rules provider is used.
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
